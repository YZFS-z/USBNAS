<?xml version="1.0" encoding="utf-8"?>
<!--
  寻找 NAS（启动页）。

  以前这里是白底 + 浅灰工具栏 + 四个蓝色文字按钮，跟媒体库/播放页的深色
  完全两个世界；四个按钮里「媒体库」和「管理设置」语义还和别人重叠。
  现在改成和媒体库同一套深色：底 #0F141A、卡片 #161B22、主色 #2F6FED。
  底部只留两个主动作（重新扫描 / 手动输入），连接成功后进的是
  「媒体库」，管理设置在媒体库页签里（见 LibraryActivity）。
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/scanRoot"
    android:background="#0F141A">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="26dp"
        android:layout_marginEnd="20dp"
        android:text="@string/scan_title"
        android:textColor="#E6E9EF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:text="@string/scan_hint"
        android:textColor="#9AA4B2"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <ProgressBar
        android:id="@+id/spinner"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="3dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:indeterminate="true"
        android:progressTint="#2F6FED"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/subtitle" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:paddingBottom="104dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/spinner" />

    <TextView
        android:id="@+id/empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:lineSpacingExtra="6dp"
        android:text="@string/empty"
        android:textColor="#7D8590"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/list" />

    <!-- 底部三个动作：重新扫描 / 手动输入 / 自动更新。
         「媒体库」与「管理设置」原本也在这里，和「点列表进媒体库」「媒体库页签里的
         管理设置」重复，已删。自动更新是唯一和「连哪台 NAS」无关的动作，但用户
         在连不上 NAS 时最需要它（服务端升级后客户端不升级会握手失败），所以
         留在首页底部，而不是藏进连上之后才进得去的设置页。 -->
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btnRescan"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:text="@string/rescan"
            android:textAllCaps="false"
            android:textColor="#D8DEE6"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_solid"
            android:text="@string/manual"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- 自动更新的入口。不叫「设置」：这个按钮点下去就是查版本 + 下载 + 装，
             不是一个设置面板；叫「更新」才不会让人以为里面有开关。 -->
        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_outline"
            android:text="@string/update"
            android:textAllCaps="false"
            android:textColor="#8AB4F8"
            android:textSize="14sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
