<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        系统栏颜色跟页面背景统一靠「透明」实现，不靠给状态栏涂同一个色号：
        - windowDrawsSystemBarBackgrounds=false / statusBarColor=transparent：
          状态栏区域不再由系统铺色，页面内容自己延伸到那里（配合
          Immersive.prepare 的 setDecorFitsSystemWindows(false)），
          于是状态栏看到的永远是页面自己的背景色 —— 页面换主题色也跟着换。
        - navigationBarColor=transparent + windowLightNavigationBar=false：
          手势栏同理（README 里 `NavigationBar0` 高 44px 那条）。
        - windowBackground 用实色 #0E1116：主题背景是 transparent 时，
          冷启动第一帧会透出桌面，闪一下白/黑。
        图标明暗（windowLightStatusBar）在代码里按页面底色动态设，见 Immersive.enter。
    -->
    <style name="Theme.USBNASLink" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#2F6FED</item>
        <item name="colorPrimaryDark">#0E1116</item>
        <item name="colorAccent">#2F6FED</item>
        <item name="android:windowBackground">#0E1116</item>
        <item name="android:windowDrawsSystemBarBackgrounds">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
