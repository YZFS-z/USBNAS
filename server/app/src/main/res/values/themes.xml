<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.USBNAS" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#1A73E8</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSurface">#171B22</item>
        <item name="colorOnSurface">#E6E9EF</item>
        <!-- 沉浸式全屏：状态栏/导航栏透明，内容铺到边缘 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowBackground">#0E1116</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
