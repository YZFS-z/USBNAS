<?xml version="1.0" encoding="utf-8"?>
<!--
  竖屏：两页翻页（与横屏同一套交互）
    第 1 页（概览）：内容由 MainActivity.buildHome() 固定生成
                    （时间 → 二维码 → 服务状态 → 手机状态），排版不可自定义
    第 2 页（控制）：服务开关、账号、共享目录、运行日志
  底部 pageBar 是翻页指示条，点按或上下滑动切换。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ViewFlipper
            android:id="@+id/flipper"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

        <!-- ================= 第 1 页：概览 ================= -->
        <!-- 竖屏首页元素多，必须能上下滚，否则底部的「温度 / 已运行 / 网络」
             会被挤到 f lipper 之外，连翻页条也顶出窗口 -->
        <ScrollView
            android:id="@+id/homeScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:saveEnabled="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">


                <!-- 首页元素（动态生成）：外面这层只是留白容器 -->
                <LinearLayout
                    android:id="@+id/homeRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>

        <!-- ================= 第 2 页：控制 ================= -->
        <ScrollView
            android:id="@+id/colMain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:saveEnabled="false"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="10dp"
                android:paddingEnd="18dp"
                android:paddingBottom="18dp">

                <!-- 服务开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnToggle"
                        style="@style/BtnPrimary"
                        android:layout_weight="1"
                        android:text="启动服务" />

                    <Button
                        android:id="@+id/btnOpen"
                        style="@style/BtnGhost"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="浏览器打开" />
                </LinearLayout>

                <!-- 账号 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/SectionTitle"
                            android:layout_weight="1"
                            android:text="账号与权限" />

                        <Button
                            android:id="@+id/btnUsers"
                            style="@style/BtnTiny"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="管理账号" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvUsers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/textDim"
                        android:textIsSelectable="true"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- 共享目录 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="共享目录" />

                    <TextView
                        android:id="@+id/tvRoots"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:fontFamily="monospace"
                        android:textColor="@color/textDim"
                        android:textIsSelectable="true"
                        android:textSize="11sp" />
                </LinearLayout>

                <!--
                    系统权限 + 显示合并成一张卡，两行铺开（3 + 2）。
                    原来拆成两张卡、各占一行，每行 48dp 的 BtnGhost 加上卡间距，
                    纵向吃掉 292px 还多出两段卡片边距。这里换成 36dp 的 BtnGhostTight
                    塞进一张卡，整块压到约 320px 里还能省下 40px 给下面的日志框。
                -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        style="@style/SectionTitle"
                        android:text="系统权限与显示" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPerm"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="存储权限" />

                        <Button
                            android:id="@+id/btnBattery"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="忽略电池优化" />

                        <Button
                            android:id="@+id/btnTitle"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="站点名称" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnAntiBurn"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="防烧屏" />

                        <Button
                            android:id="@+id/btnScreenOff"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="立即熄屏" />
                    </LinearLayout>

                    <!-- 外接盘休眠：机械盘不转就没有嗡嗡声 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnUsbSleep"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="U 盘休眠" />

                        <Button
                            android:id="@+id/btnUsbSleepNow"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="立即停转" />
                    </LinearLayout>

                    <!-- 曲库目录：管理员指一次，客户端播放器直接读这份清单 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnMusicDirs"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="音乐目录" />

                        <!-- 影视目录：与音乐分开存，且允许多个（盘0 + 盘1 并存） -->
                        <Button
                            android:id="@+id/btnVideoDirs"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:text="影视目录" />
                    </LinearLayout>

                    <!--
                        自动更新：默认关闭。按钮只显示当前状态，点开是一个小对话框，
                        里面才有开关和「立即检查」。放在这一行的最外侧，是因为它
                        跟音乐/影视目录不是一类事 —— 那些是「这台机器怎么服务别人」，
                        这个是「这台机器自己要不要联网」。
                    -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnUpdate"
                            style="@style/BtnGhostTight"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:text="自动更新 关" />

                        <TextView
                            android:id="@+id/tvUpdate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1.6"
                            android:gravity="center_vertical"
                            android:minHeight="44dp"
                            android:text="版本 —"
                            android:textColor="#8A93A0"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 运行日志 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/SectionTitle"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:text="运行日志" />

                    <Button
                        android:id="@+id/btnClear"
                        style="@style/BtnTiny"
                        android:text="清空" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scrollLog"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_inset"
                    android:saveEnabled="false">

                    <TextView
                        android:id="@+id/tvLog"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="3dp"
                        android:padding="12dp"
                        android:textColor="#7EE787"
                        android:textIsSelectable="true"
                        android:textSize="10sp" />
                </ScrollView>
            </LinearLayout>
        </ScrollView>
    </ViewFlipper>
    </LinearLayout>

    <!--
      底部翻页条。
      window.setDecorFitsSystemWindows(false) 之后 DecorView 铺满 1080x2400，
      但内容真正能画的区间是 mAppBounds（底部被导航栏手势区占掉 44dp），
      这一条必须自己让开导航栏高度，否则整条落在窗口外、点不到。
      高度与横屏对齐到 26dp、页签 20dp：比原来的 18dp 仍然宽裕，但不再吃掉首页一整行。
    -->
    <LinearLayout
        android:id="@+id/pageBar"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dot0"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:background="@drawable/bg_pill"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="概览"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dot1"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:layout_marginStart="12dp"
            android:gravity="center"
            android:minWidth="84dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="控制"
            android:textColor="@color/textMute"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
